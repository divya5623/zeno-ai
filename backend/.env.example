# Solvely AI Backend Configuration

# Database: PostgreSQL (with pgvector for production) or SQLite for zero-config local dev
DATABASE_URL=sqlite:///./solvely.db
# For production PostgreSQL + pgvector:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/solvely_ai

# Environment & Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:8080","http://localhost:3000","http://127.0.0.1:8080","http://127.0.0.1:5500"]

# Authentication & Security
SECRET_KEY=solvely-super-secret-jwt-key-2026-production-ready
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Credentials (Optional: smart pedagogical mock engine activates if keys absent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Vector Database (Pinecone for production RAG)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=solvely-knowledge-base

# Speech to Text (OpenAI Whisper or Deepgram)
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
DEEPGRAM_API_KEY=
