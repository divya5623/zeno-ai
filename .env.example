# PayPal Sandbox Environment Configuration
# NEVER commit your actual client secret or production credentials to version control.

# PayPal Sandbox Client ID (obtain from developer.paypal.com)
PAYPAL_CLIENT_ID=your_sandbox_client_id_here

# PayPal Sandbox Secret (Server-side only; never expose in frontend)
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here

# PayPal Sandbox API Base URL
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PayGuard Environment Mode ('SANDBOX' or 'DEMO')
PAYPAL_MODE=SANDBOX
VITE_PAYPAL_MODE=SANDBOX
